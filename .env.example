# Google Gemini API key
# (Optional: If left unset or as MY_GEMINI_API_KEY, the server falls back to an offline rule-based triage simulator)
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Port binding configuration (Default: 3000)
PORT=3000

# Environment Mode (development or production)
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/myneighbourhood
